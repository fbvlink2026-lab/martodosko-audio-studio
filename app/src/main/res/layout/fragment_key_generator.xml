<?xml version="1.0" encoding="utf-8"?>
<!-- ================================================== -->
<!-- FILE: fragment_key_generator.xml — ✅ KUMPLETO! GENERATE • LIST • REVOKE • EXPIRE! -->
<!-- VERSION: 1.0.0 — 👑 OWNER LANG — MEMBER + ADMIN KEYS! -->
<!-- UPDATED: 2026-09-21 -->
<!-- ================================================== -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12121F"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 🔑 HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="#1E1E2F"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔑 KEY GENERATOR"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFD700"/>

            <TextView
                android:id="@+id/tv_keygen_user_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👑 OWNER — Buong Kapangyarihan"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- ⚠️ NOTE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ 👑 OWNER LANG ANG MAKAKAGAMIT!\nAng mga key na nabuo ay maaaring gamitin sa Admin Login."
            android:textSize="12sp"
            android:textColor="#FFD700"
            android:padding="12dp"
            android:background="#2A2A1A"
            android:layout_marginBottom="20dp"/>

        <!-- 📝 FORM -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Pangalan ng Miyembro"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/et_member_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ilagay ang pangalan..."
            android:inputType="textPersonName|textNoSuggestions"
            android:textColor="#FFFFFF"
            android:hintTextColor="#555555"
            android:background="#1E1E2F"
            android:padding="14dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <!-- 🔑 KEY TYPE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔑 Uri ng Key"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinner_key_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E2F"
            android:padding="14dp"
            android:layout_marginBottom="16dp"/>

        <!-- ⏰ EXPIRY -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏰ Mag-e-expire Pagkatapos"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinner_expiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E2F"
            android:padding="14dp"
            android:layout_marginBottom="20dp"/>

        <!-- ✅ GENERATE BUTTON -->
        <Button
            android:id="@+id/btn_generate_key"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="🔑 BUMUO NG BAGONG KEY"
            android:background="#B8860B"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2E2E4A"
            android:layout_marginBottom="16dp"/>

        <!-- 📋 LIST HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 MGA NAIBIGAY NA KEY"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#40E0D0"/>

            <Button
                android:id="@+id/btn_clear_all_keys"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🗑️ LAHAT"
                android:background="#4A1A1A"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"/>
        </LinearLayout>

        <!-- 📋 KEYS LIST -->
        <TextView
            android:id="@+id/keygen_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Wala pang naibigay na key."
            android:textSize="13sp"
            android:textColor="#888888"
            android:padding="8dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/keys_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <!-- ⏳ PROGRESS -->
        <ProgressBar
            android:id="@+id/keygen_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:indeterminate="true"
            android:visibility="gone"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"/>

    </LinearLayout>
</ScrollView>
