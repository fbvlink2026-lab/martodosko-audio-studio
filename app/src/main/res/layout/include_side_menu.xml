<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12121F"
    android:padding="16dp">

    <!-- APP NAME -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MARTODOSKO"
        android:textColor="#40E0D0"
        android:textSize="24sp"
        android:textStyle="bold"
        android:padding="20dp"
        android:gravity="center"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A3A"
        android:layout_marginBottom="16dp"/>

    <!-- MENU ITEMS — PAREHO SA MAINACTIVITY! -->
    <TextView
        android:id="@+id/menu_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏠 HOME"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/menu_mixer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎚️ MIXER"
        android:textColor="#40E0D0"
        android:textSize="16sp"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/menu_effects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎸 EFFECTS"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/menu_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 UPDATE"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/menu_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="❓ HELP"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/menu_join"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌐 JOIN"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/menu_about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ℹ️ ABOUT"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- VERSION -->
    <TextView
        android:id="@+id/tv_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="v1.0.0"
        android:textColor="#666677"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="16dp"/>

</LinearLayout>
