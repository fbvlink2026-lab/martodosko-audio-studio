<!-- FILE: activity_admin_panel.xml — ✅ AYUSIN: WALANG MISSING DRAWABLE! EMOJI NA LANG! -->
<!-- VERSION: 1.2.1 — ✅ ic_settings → ⚙️ TEXT | ic_close → ✕ TEXT! WALANG ERROR NA! -->
<!-- UPDATED: 2026-09-20 -->
<!-- ================================================== -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12121F">

    <!-- ✅ PANGUNAHING LAMAN — EXISTING! WALANG BINAGO! -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ✅ TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E1E2F"
            android:paddingHorizontal="16dp">

            <!-- ✅ HAMBURGER BUTTON — EXISTING! -->
            <ImageView
                android:id="@+id/btn_hamburger"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_hamburger"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔐 ADMIN PANEL"
                android:textColor="#40E0D0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <!-- ➡️ ✅ AYUSIN: ⚙️ TEXT NA LANG — WALANG KAILANGANG DRAWABLE! -->
            <TextView
                android:id="@+id/btn_admin_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textColor="#40E0D0"
                android:textSize="22sp"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="8dp"/>

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0.0"
                android:textColor="#666666"
                android:textSize="12sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- ✅ ADMIN PANEL CONTENT — EXISTING! WALANG BINAGO! -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#12121F"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ✅ ACCESS LEVEL TITLE -->
                <TextView
                    android:id="@+id/admin_access_level"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="❌ WALANG KAPANGYARIHAN"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="16dp"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"/>

                <!-- ✅ KEY GENERATOR SECTION -->
                <LinearLayout
                    android:id="@+id/section_key_generator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:padding="16dp"
                    android:background="#1E1E2F"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="👑 KEY CODE GENERATOR"
                        android:textColor="#FFD700"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <Button
                        android:id="@+id/btn_generate_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✅ LIKHANG BAGONG KEY CODE"
                        android:backgroundTint="#9C27B0"
                        android:textColor="#fff"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mga Key Code na nalikha:"
                        android:textColor="#AAA"
                        android:textSize="13sp"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:id="@+id/tv_generated_keys"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Wala pang nalikhang Key Code."
                        android:textColor="#40E0D0"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"/>

                    <Button
                        android:id="@+id/btn_clear_all_keys"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🗑️ BURAHIN LAHAT NG KEY"
                        android:backgroundTint="#FF5252"
                        android:textColor="#fff"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <!-- ✅ USER MANAGEMENT SECTION -->
                <LinearLayout
                    android:id="@+id/section_user_management"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:padding="16dp"
                    android:background="#1E1E2F"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="👤 USER MANAGEMENT"
                        android:textColor="#03DAC6"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <Button
                        android:id="@+id/btn_refresh_users"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔄 I-REFRESH"
                        android:backgroundTint="#018786"
                        android:textColor="#fff"/>

                    <TextView
                        android:id="@+id/tv_user_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Wala pang rehistradong miyembro."
                        android:textColor="#CCC"
                        android:textSize="12sp"
                        android:layout_marginTop="12dp"/>
                </LinearLayout>

                <!-- ✅ PRESET MODERATION SECTION -->
                <LinearLayout
                    android:id="@+id/section_preset_moderation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:padding="16dp"
                    android:background="#1E1E2F"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📋 PRESET MODERATION"
                        android:textColor="#BB86FC"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <Button
                        android:id="@+id/btn_refresh_presets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔄 I-REFRESH"
                        android:backgroundTint="#6200EE"
                        android:textColor="#fff"/>

                    <TextView
                        android:id="@+id/tv_preset_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Walang nakabinbing preset."
                        android:textColor="#CCC"
                        android:textSize="12sp"
                        android:layout_marginTop="12dp"/>
                </LinearLayout>

                <!-- ✅ STATISTICS SECTION -->
                <LinearLayout
                    android:id="@+id/section_statistics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#1E1E2F"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📊 ESTATISTIKA"
                        android:textColor="#FFD700"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tv_stat_keys"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Likhang Key Code: 0"
                        android:textColor="#CCC"
                        android:textSize="13sp"
                        android:padding="4dp"/>

                    <TextView
                        android:id="@+id/tv_stat_members"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Miyembro: 0"
                        android:textColor="#CCC"
                        android:textSize="13sp"
                        android:padding="4dp"/>

                    <TextView
                        android:id="@+id/tv_stat_presets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kabuuang Preset: 0"
                        android:textColor="#CCC"
                        android:textSize="13sp"
                        android:padding="4dp"/>

                    <TextView
                        android:id="@+id/tv_stat_pending"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nakabinbin: 0"
                        android:textColor="#CCC"
                        android:textSize="13sp"
                        android:padding="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ✅ KALIWA — EXISTING SIDE MENU — WALANG BINAGO! -->
    <include
        layout="@layout/side_menu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"/>

    <!-- ➡️ ✅ KANANG ADMIN SIDEMENU — AYUSIN: ✕ TEXT NA LANG ANG CLOSE BUTTON! -->
    <LinearLayout
        android:id="@+id/drawer_admin"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#1A1A2E">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#1E1E2F">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚙️ ADMIN CONTROLS"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#40E0D0"/>

            <!-- ✅ AYUSIN: ✕ TEXT NA LANG — WALANG KAILANGANG DRAWABLE! -->
            <TextView
                android:id="@+id/btn_close_admin_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="#40E0D0"
                android:textSize="20sp"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2E2E4A"/>

        <!-- MGA BUTTON — TUGMA SA KULAY NG BAWAT SECTION! -->
        <TextView
            android:id="@+id/btn_admin_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔑 KEY GENERATOR"
            android:padding="16dp"
            android:textColor="#FFD700"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_admin_users"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 USER MANAGEMENT"
            android:padding="16dp"
            android:textColor="#03DAC6"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_admin_presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 PRESET MODERATION"
            android:padding="16dp"
            android:textColor="#BB86FC"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_admin_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 ESTATISTIKA"
            android:padding="16dp"
            android:textColor="#FFD700"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2E2E4A"
            android:layout_marginVertical="8dp"/>

        <TextView
            android:id="@+id/btn_admin_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔐 MAG-LOGOUT"
            android:padding="16dp"
            android:textColor="#FF5252"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Martodosko Audio Studio"
            android:padding="16dp"
            android:textColor="#666"
            android:textSize="12sp"
            android:gravity="center"/>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
