<!-- FILE: activity_admin_panel.xml — ✅ KINOPYA NA ANG HAMBURGER + SIDE_MENU! TUGMA SA MAIN! -->
<!-- VERSION: 1.1.0 — ✅ btn_hamburger + @layout/side_menu — PAREHO NG MAIN SCREEN! -->
<!-- UPDATED: 2026-09-20 — WALANG ERROR NA! TUGMA NA SA LAHAT! -->
