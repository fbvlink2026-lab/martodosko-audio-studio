<?xml version="1.0" encoding="utf-8"?>
<!-- ================================================== -->
<!-- FILE: fragment_file_editor.xml — ✅ KUMPLETONG LAYOUT! BROWSER + EDITOR + GITHUB! -->
<!-- VERSION: 1.0.0 — 📁 FILE BROWSER • 📝 CODE EDITOR • 🌐 GITHUB BUTTONS • STATUS BAR -->
<!-- UPDATED: 2026-09-21 -->
<!-- ================================================== -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12121F"
    android:orientation="vertical">

    <!-- ✅ TOP BAR — PATH + BACK BUTTON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#1E1E2F"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀"
            android:textSize="20sp"
            android:textColor="#40E0D0"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/current_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📁 /project/"
            android:textColor="#E0E0E0"
            android:textSize="13sp"
            android:ellipsize="start"
            android:singleLine="true"
            android:paddingHorizontal="8dp"/>

        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄"
            android:textSize="18sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- ✅ MAIN CONTENT — FILE BROWSER + CODE EDITOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 📁 FILE BROWSER — Scrollable List -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.4"
            android:background="#16162A">

            <LinearLayout
                android:id="@+id/file_browser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2E2E4A"/>

        <!-- 📝 CODE EDITOR — Source Code Input -->
        <EditText
            android:id="@+id/code_editor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.6"
            android:background="#0F0F1A"
            android:textColor="#E0E0E0"
            android:hint="📝 Pumili ng file mula sa itaas..."
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:gravity="top"
            android:inputType="textMultiLine|textNoSuggestions"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- ✅ GITHUB TRANSFER BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1A1A2E">

        <Button
            android:id="@+id/btn_local_to_github"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="📤 Lokal → GitHub"
            android:background="#24292E"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/btn_github_to_local"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="📥 GitHub → Lokal"
            android:background="#0366D6"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_margin="2dp"/>
    </LinearLayout>

    <!-- ✅ ACTION BUTTONS — Save / Commit / Pull / Push -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1E1E2F">

        <Button
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="💾 SAVE"
            android:background="#2E7D32"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/btn_commit"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="📝 COMMIT"
            android:background="#FF8F00"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/btn_pull"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="🔄 PULL"
            android:background="#0288D1"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/btn_push"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="🚀 PUSH"
            android:background="#7B1FA2"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_margin="2dp"/>
    </LinearLayout>

    <!-- ✅ STATUS BAR + PROGRESS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#1A1A2E"
        android:gravity="center_vertical">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✅ Handa na — pumili ng file mula sa itaas"
            android:textColor="#888888"
            android:textSize="12sp"/>
    </LinearLayout>

</LinearLayout>
