<?xml version="1.0" encoding="utf-8"?>
<!-- ================================================== -->
<!-- FILE: side_menu.xml — ✅ PANGALAN AYON SA UTOS! WALANG IBANG PINAGBAGO! -->
<!-- VERSION: 1.4.0 — ✅ Vocal Preset→Vocal Channel | Vocal Preset Controls→Vocal Presets | Guitar Preset→Guitar Presets -->
<!-- UPDATED: 2026-09-19 — TATLONG LINYA LANG ANG PALITAN! -->
<!-- ================================================== -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="#1A1A2E"
    android:orientation="vertical"
    android:elevation="16dp">

    <!-- ✅ MENU HEADER + X BUTTON → ISARA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#16162A">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MENU"
            android:textColor="#40E0D0"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/btn_close_menu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333344"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <!-- ============================================== -->
        <!-- ✅ MIXER → NAKATIKLOP SA SIMULA! -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/menu_mixer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="▶  🎚️  Mixer"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:id="@+id/submenu_mixer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:visibility="gone">

                <!-- ✅ 1. PINALITAN: Vocal Preset → Vocal Channel -->
                <TextView
                    android:id="@+id/submenu_mixer_vocal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🎤  Vocal Channel"
                    android:textColor="#CCCCCC"
                    android:textSize="15sp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- ✅ 2. PINALITAN: Vocal Preset Controls → Vocal Presets -->
                <TextView
                    android:id="@+id/submenu_mixer_presets"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="📋  Vocal Presets"
                    android:textColor="#CCCCCC"
                    android:textSize="15sp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================== -->
        <!-- ✅ GUITAR EFFECTS → NAKATIKLOP NA! -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/menu_guitar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="▶  🎸  Guitar Effects"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:id="@+id/submenu_guitar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/submenu_guitar_channel"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🎸  Guitar Channel"
                    android:textColor="#CCCCCC"
                    android:textSize="15sp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- ✅ 3. PINALITAN: Guitar Preset → Guitar Presets -->
                <TextView
                    android:id="@+id/submenu_guitar_presets"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="📋  Guitar Presets"
                    android:textColor="#CCCCCC"
                    android:textSize="15sp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ✅ IBA — WALANG PINAGBAGO! -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/menu_presets"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="▶  📋  Presets"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:id="@+id/submenu_presets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/submenu_presets_global"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="📋  Pangkalahatang Presets"
                    android:textColor="#CCCCCC"
                    android:textSize="15sp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/submenu_presets_free"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🆓  Non-Member Presets"
                    android:textColor="#CCCCCC"
                    android:textSize="15sp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/menu_settings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="▶  ⚙️  Settings"
                android:textColor="#40E0D0"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:id="@+id/submenu_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/submenu_settings_audio"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🔊  Audio Settings"
                    android:textColor="#CCCCCC"
                    android:textSize="15sp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/submenu_settings_appearance"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🎨  Appearance"
                    android:textColor="#CCCCCC"
                    android:textSize="15sp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/menu_update"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🔄  Check Update"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/menu_help"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="❓  Help"
            android:textColor="#40E0D0"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/menu_join"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🌐  Join Us"
            android:textColor="#00BFFF"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/menu_about"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ℹ️  About"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/menu_admin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🔐  Admin Panel"
            android:textColor="#FFD700"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/menu_whatsnew"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🆕  What's New"
            android:textColor="#00FF88"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/menu_exit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="❌  Exit"
            android:textColor="#FF6B6B"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</LinearLayout>
