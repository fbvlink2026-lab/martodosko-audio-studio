<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080810"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎚️ MIXER"
            android:textColor="#40E0D0"
            android:textSize="22sp"
            android:gravity="center"
            android:paddingBottom="32dp"/>

        <!-- CHANNEL HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎤 VOCAL CHANNEL"
            android:textColor="#40E0D0"
            android:textSize="18sp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:background="#12121F"/>

        <!-- ================================================== -->
        <!-- ✅ KNOB CONTAINER — MAY ESPASYO SA PALIGID PARA SA MGA NUMERO! -->
        <!-- LABEL (TAAS) → KNOB (GITNA) → VALUE (IBABA) -->
        <!-- ================================================== -->
        <!-- ✅ ESPASYO SA KALIWA AT KANAN PARA SA -50 AT +50 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="32dp"
            android:paddingBottom="32dp"
            android:paddingLeft="48dp"
            android:paddingRight="48dp"
            android:background="#12121F"
            android:layout_marginTop="8dp">

            <!-- ✅ 1. PANGALAN — NASA TAAS! -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GAIN"
                android:textColor="#AAAAAA"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <!-- ✅ 2. KNOB — LUMIIT NA (100dp) + MAY ESPASYO SA PALIGID! -->
            <com.martodosko.studio.KnobView
                android:id="@+id/knob_gain"
                android:layout_width="100dp"
                android:layout_height="100dp"/>

            <!-- ✅ 3. HALAGA — NASA IBABA NG KNOB! -->
            <TextView
                android:id="@+id/tv_gain_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 dB"
                android:textColor="#40E0D0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
