<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ✅ TOP BAR — WALANG BINAGO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E1E2F"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btn_hamburger"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_hamburger"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MIXER"
                android:textColor="#40E0D0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <View
                android:layout_width="32dp"
                android:layout_height="32dp"/>
        </LinearLayout>

        <!-- ✅ VERTICAL SCROLL -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#081218"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ✅ INPUT SECTION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📥 INPUT"
                    android:textColor="#40E0D0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:background="#12232E"/>

                <!-- ✅ VERTICAL NA — SENSITIVITY NASA IBABA NG GAIN! WALANG HORIZONTAL SCROLL! -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="12dp">

                    <!-- ✅ GAIN KNOB -->
                    <com.martodosko.studio.KnobView
                        android:id="@+id/knob_gain"
                        android:layout_width="140dp"
                        android:layout_height="160dp"
                        android:layout_margin="4dp"/>

                    <!-- ✅ SENSITIVITY KNOB — NASA IBABA NA! -->
                    <com.martodosko.studio.KnobView
                        android:id="@+id/knob_sensitivity"
                        android:layout_width="140dp"
                        android:layout_height="160dp"
                        android:layout_margin="4dp"/>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- ✅ SIDE MENU — WALANG BINAGO -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1A1A2E"
        android:orientation="vertical"
        android:elevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#16162A">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MENU"
                android:textColor="#40E0D0"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/btn_close_menu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333344"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/menu_mixer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🎚️  Mixer"
                android:textColor="#40E0D0"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_presets"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📋  Presets"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_settings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="⚙️  Settings"
                android:textColor="#40E0D0"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_effects"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🎸  Guitar Effects"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_update"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🔄  Check Update"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_help"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="❓  Help"
                android:textColor="#40E0D0"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_join"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🌐  Join Us"
                android:textColor="#00BFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_about"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="ℹ️  About"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
