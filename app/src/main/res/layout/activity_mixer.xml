<?xml version="1.0" encoding="utf-8"?>
<!-- ================================================== -->
<!-- FILE: activity_mixer.xml — ✅ GUMAGAMIT NA SA SARILING KNOB + SLIDER CLASSES! -->
<!-- VERSION: 7.0.0 — ✅ LAHAT MAY SARILING PANGALAN! KUSANG MAY LABEL + SAVE! -->
<!-- UPDATED: 2026-09-18 — WALANG IBANG PINAGBAGO! PALITAN LANG ANG PANGALAN NG KLASE! -->
<!-- ================================================== -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- ✅ PANGUNAHING LAMAN — MIXER SCREEN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ✅ TOP BAR — MAY HAMBURGER BUTTON! -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E1E2F"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btn_hamburger"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_hamburger"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MIXER"
                android:textColor="#40E0D0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <View
                android:layout_width="32dp"
                android:layout_height="32dp"/>
        </LinearLayout>

        <!-- ✅ VERTICAL SCROLL — PATAAS / PABABA ✅ -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#081218"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ================================================== -->
                <!-- 📥 INPUT SECTION -->
                <!-- ================================================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📥 INPUT"
                    android:textColor="#40E0D0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:background="#12232E"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- ✅ SARILING KNOB CLASS! -->
                        <com.martodosko.studio.GainKnob
                            android:id="@+id/knob_gain"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.SensitivityKnob
                            android:id="@+id/knob_sensitivity"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ================================================== -->
                <!-- 🎚️ EQ / TONE SECTION -->
                <!-- ================================================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎚️ EQ / TONE"
                    android:textColor="#40E0D0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:layout_marginTop="24dp"
                    android:background="#12232E"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.martodosko.studio.EqLowKnob
                            android:id="@+id/knob_eq_low"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.EqLowMidKnob
                            android:id="@+id/knob_eq_lowmid"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.EqMidKnob
                            android:id="@+id/knob_eq_mid"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.EqHighMidKnob
                            android:id="@+id/knob_eq_highmid"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.EqHighKnob
                            android:id="@+id/knob_eq_high"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.EqPresenceKnob
                            android:id="@+id/knob_eq_presence"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ================================================== -->
                <!-- 🏛️ REVERB SECTION -->
                <!-- ================================================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏛️ REVERB"
                    android:textColor="#40E0D0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:layout_marginTop="24dp"
                    android:background="#12232E"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.martodosko.studio.ReverbMixKnob
                            android:id="@+id/knob_reverb_mix"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.ReverbDecayKnob
                            android:id="@+id/knob_reverb_decay"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.ReverbPredelayKnob
                            android:id="@+id/knob_reverb_predelay"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ================================================== -->
                <!-- ⏱️ DELAY SECTION -->
                <!-- ================================================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⏱️ DELAY"
                    android:textColor="#40E0D0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:layout_marginTop="24dp"
                    android:background="#12232E"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.martodosko.studio.DelayTimeKnob
                            android:id="@+id/knob_delay_time"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.DelayFeedbackKnob
                            android:id="@+id/knob_delay_feedback"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.DelayMixKnob
                            android:id="@+id/knob_delay_mix"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ================================================== -->
                <!-- 🎵 CHORUS SECTION -->
                <!-- ================================================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎵 CHORUS"
                    android:textColor="#40E0D0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:layout_marginTop="24dp"
                    android:background="#12232E"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.martodosko.studio.ChorusMixKnob
                            android:id="@+id/knob_chorus_mix"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.ChorusSpeedKnob
                            android:id="@+id/knob_chorus_speed"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.ChorusDepthKnob
                            android:id="@+id/knob_chorus_depth"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ================================================== -->
                <!-- 🔥 DISTORTION SECTION -->
                <!-- ================================================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔥 DISTORTION"
                    android:textColor="#40E0D0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:layout_marginTop="24dp"
                    android:background="#12232E"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.martodosko.studio.DistortionKnob
                            android:id="@+id/knob_distortion"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.DistortionToneKnob
                            android:id="@+id/knob_dist_tone"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ================================================== -->
                <!-- 📊 COMPRESSOR SECTION -->
                <!-- ================================================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 COMPRESSOR"
                    android:textColor="#40E0D0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:layout_marginTop="24dp"
                    android:background="#12232E"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.martodosko.studio.CompThresholdKnob
                            android:id="@+id/knob_comp_threshold"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.CompRatioKnob
                            android:id="@+id/knob_comp_ratio"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.CompAttackKnob
                            android:id="@+id/knob_comp_attack"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.CompReleaseKnob
                            android:id="@+id/knob_comp_release"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.CompMakeupKnob
                            android:id="@+id/knob_comp_makeup"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ================================================== -->
                <!-- 📤 OUTPUT SECTION -->
                <!-- ================================================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📤 OUTPUT"
                    android:textColor="#40E0D0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:layout_marginTop="24dp"
                    android:background="#12232E"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.martodosko.studio.PanKnob
                            android:id="@+id/knob_pan"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>

                        <com.martodosko.studio.ChannelVolumeKnob
                            android:id="@+id/knob_channel_volume"
                            android:layout_width="140dp"
                            android:layout_height="160dp"
                            android:layout_margin="4dp"/>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ================================================== -->
                <!-- 📏 MASTER SLIDERS — PALITAN ANG SEEKBAR NG SARILING SLIDER! -->
                <!-- ================================================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📏 MASTER"
                    android:textColor="#40E0D0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:layout_marginTop="24dp"
                    android:background="#12232E"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- ✅ SARILING SLIDER — HINDI NA SEEKBAR! -->
                    <com.martodosko.studio.MasterVolumeSlider
                        android:id="@+id/slider_master"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <com.martodosko.studio.LeftMonitorSlider
                            android:id="@+id/slider_master_left"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"/>

                        <com.martodosko.studio.RightMonitorSlider
                            android:id="@+id/slider_master_right"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- ✅ SIDE MENU — WALANG PINAGBAGO! -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1A1A2E"
        android:orientation="vertical"
        android:elevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#16162A">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MENU"
                android:textColor="#40E0D0"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/btn_close_menu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333344"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/menu_mixer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🎚️  Mixer"
                android:textColor="#40E0D0"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_presets"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📋  Presets"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_settings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="⚙️  Settings"
                android:textColor="#40E0D0"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_effects"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🎸  Guitar Effects"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_update"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🔄  Check Update"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_help"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="❓  Help"
                android:textColor="#40E0D0"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_join"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🌐  Join Us"
                android:textColor="#00BFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_about"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="ℹ️  About"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
