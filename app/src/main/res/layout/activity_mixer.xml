<!-- UPDATED: 2026-09-12 -->
<!-- ================================================== -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080810">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- 📌 PAMAGAT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp"
            android:background="#12121F"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎛️ MARTODOSKO 3-CHANNEL MIXER"
                android:textColor="#40E0D0"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- 📌 PANGUNAHING LAYOUT — 3 CHANNEL KNOBS SA KALIWA | SLIDERS SA KANAN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- ============================================== -->
            <!-- ✅ KALIWA — 3 CHANNEL, BAWAT MAY SARILING KNOBS! -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.58"
                android:orientation="vertical"
                android:background="#151522"
                android:padding="10dp"
                android:layout_marginEnd="4dp">

                <!-- ============= CHANNEL 1 — 🎤 VOCALS ============= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1A1A2E"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎤 CHANNEL 1 — VOCALS"
                        android:textColor="#FF6B9D"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:paddingBottom="8dp"/>

                    <!-- TREBLE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/voc_treble"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="TREBLE" android:textColor="#FFD700" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/voc_treble_val" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- MID -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/voc_mid"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="MID" android:textColor="#FF9500" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/voc_mid_val" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- BASS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/voc_bass"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="BASS" android:textColor="#40E0D0" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/voc_bass_val" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- REVERB -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/voc_reverb"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="REVERB" android:textColor="#BB86FC" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/voc_reverb_val" android:text="0%" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- DELAY -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/voc_delay"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="DELAY" android:textColor="#00BFFF" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/voc_delay_val" android:text="0ms" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- DECAY -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/voc_decay"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="DECAY" android:textColor="#FF6B6B" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/voc_decay_val" android:text="0%" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- CHANNEL VOLUME — PINAKAIBABA NG CHANNEL 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="6dp"
                        android:layout_marginTop="4dp"
                        android:background="#252540"
                        android:padding="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/voc_vol"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="CHANNEL VOLUME" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/voc_vol_val" android:text="-12 dB" android:textColor="#AAA" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ============= CHANNEL 2 — 🎸 INSTRUMENTS ============= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1A2E28"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎸 CHANNEL 2 — INSTRUMENTS"
                        android:textColor="#40E0D0"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:paddingBottom="8dp"/>

                    <!-- TREBLE -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/inst_treble"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="TREBLE" android:textColor="#FFD700" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/inst_treble_val" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- MID -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/inst_mid"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="MID" android:textColor="#FF9500" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/inst_mid_val" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- BASS -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/inst_bass"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="BASS" android:textColor="#40E0D0" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/inst_bass_val" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- REVERB -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/inst_reverb"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="REVERB" android:textColor="#BB86FC" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/inst_reverb_val" android:text="0%" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- DELAY -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/inst_delay"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="DELAY" android:textColor="#00BFFF" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/inst_delay_val" android:text="0ms" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- DECAY -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/inst_decay"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="DECAY" android:textColor="#FF6B6B" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/inst_decay_val" android:text="0%" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- CHANNEL VOLUME — PINAKAIBABA NG CHANNEL 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="6dp"
                        android:layout_marginTop="4dp"
                        android:background="#204035"
                        android:padding="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/inst_vol"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="CHANNEL VOLUME" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/inst_vol_val" android:text="-12 dB" android:textColor="#AAA" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ============= CHANNEL 3 — 🎵 MUSIC / BACKGROUND ============= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1A2330"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎵 CHANNEL 3 — MUSIC / BACKGROUND"
                        android:textColor="#00BFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:paddingBottom="8dp"/>

                    <!-- TREBLE -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/mus_treble"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="TREBLE" android:textColor="#FFD700" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/mus_treble_val" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- MID -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/mus_mid"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="MID" android:textColor="#FF9500" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/mus_mid_val" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- BASS -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/mus_bass"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="BASS" android:textColor="#40E0D0" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/mus_bass_val" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- REVERB -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/mus_reverb"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="REVERB" android:textColor="#BB86FC" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/mus_reverb_val" android:text="0%" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- DELAY -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/mus_delay"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="DELAY" android:textColor="#00BFFF" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/mus_delay_val" android:text="0ms" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- DECAY -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/mus_decay"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="DECAY" android:textColor="#FF6B6B" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/mus_decay_val" android:text="0%" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- CHANNEL VOLUME — PINAKAIBABA NG CHANNEL 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="6dp"
                        android:layout_marginTop="4dp"
                        android:background="#253050"
                        android:padding="6dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/mus_vol"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="CHANNEL VOLUME" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/mus_vol_val" android:text="-12 dB" android:textColor="#AAA" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- ============================================== -->
            <!-- ✅ KANAN — SLIDERS LANG: LEFT → RIGHT → MASTER -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.42"
                android:orientation="vertical"
                android:background="#151522"
                android:padding="12dp"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎚️ OUTPUT & MASTER"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:paddingBottom="12dp"/>

                <!-- ◀ LEFT CHANNEL -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◀ LEFT" android:textColor="#40E0D0" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                <SeekBar android:id="@+id/slider_left" android:layout_width="match_parent" android:layout_height="wrap_content" android:progress="50" android:max="100" android:progressTint="#40E0D0" android:thumbTint="#FFFFFF" android:layout_marginBottom="20dp"/>

                <!-- ▶ RIGHT CHANNEL -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶ RIGHT" android:textColor="#FF6B9D" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                <SeekBar android:id="@+id/slider_right" android:layout_width="match_parent" android:layout_height="wrap_content" android:progress="50" android:max="100" android:progressTint="#FF6B9D" android:thumbTint="#FFFFFF" android:layout_marginBottom="20dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A3C" android:layout_marginVertical="6dp"/>

                <!-- ⬡ MONO TOGGLE -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MONO" android:textColor="#AAAAAA" android:textSize="13sp" android:textStyle="bold"/>
                    <ToggleButton android:id="@+id/btn_mono" android:layout_width="56dp" android:layout_height="32dp" android:textOff="OFF" android:textOn="ON" android:backgroundTint="#2A2A3C" android:textColor="#FFFFFF" android:textSize="11sp"/>
                </LinearLayout>

                <!-- 🔊 MASTER VOLUME — PINAKAHULI! -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔊 MASTER VOLUME" android:textColor="#FFD700" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/master_vol_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-0 dB" android:textColor="#FFD700" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                <SeekBar android:id="@+id/slider_master" android:layout_width="match_parent" android:layout_height="wrap_content" android:progress="65" android:max="100" android:progressTint="#FFD700" android:thumbTint="#FFFFFF" android:layout_marginBottom="16dp"/>

                <!-- 🔇 MUTE + ⚡ BYPASS -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gap="8dp">
                    <ToggleButton android:id="@+id/btn_mute_all" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textOff="🔇 MUTE" android:textOn="🔇 MUTED" android:backgroundTint="#440000" android:textColor="#FFFFFF" android:paddingVertical="10dp" android:textSize="12sp"/>
                    <ToggleButton android:id="@+id/btn_bypass" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textOff="⚡ BYPASS" android:textOn="⚡ ACTIVE" android:backgroundTint="#003333" android:textColor="#FFFFFF" android:paddingVertical="10dp" android:textSize="12sp"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
