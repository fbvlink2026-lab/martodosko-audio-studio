<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#081218"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MIXER"
            android:textColor="#40E0D0"
            android:textSize="22sp"
            android:gravity="center"
            android:paddingBottom="16dp"/>

        <!-- CHANNEL HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VOCAL CHANNEL"
            android:textColor="#40E0D0"
            android:textSize="18sp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:background="#12232E"/>

        <!-- ✅ KNOB AREA — 140dp × 160dp! TUGMA SA KnobView! MAY ESPASYO PA! -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:background="#12232E"
            android:layout_marginTop="8dp">

            <!-- ✅ GAIN KNOB — ID = knob_gain → TUGMA SA MixerActivity.kt! -->
            <com.martodosko.studio.KnobView
                android:id="@+id/knob_gain"
                android:layout_width="140dp"
                android:layout_height="160dp"/>

            <!-- ✅ DAGDAG MO LANG DITO ANG IBA — HANDANG-HANDA NA!
            <com.martodosko.studio.KnobView
                android:id="@+id/knob_bass"
                android:layout_width="140dp"
                android:layout_height="160dp"
                android:layout_marginTop="24dp"/>

            <com.martodosko.studio.KnobView
                android:id="@+id/knob_treble"
                android:layout_width="140dp"
                android:layout_height="160dp"
                android:layout_marginTop="24dp"/>
            -->

        </LinearLayout>

    </LinearLayout>
</ScrollView>
