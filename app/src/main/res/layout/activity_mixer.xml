<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- ✅ PANGUNAHING LAMAN — WALANG BINAGO! -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ✅ TOP BAR — WALANG BINAGO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E1E2F"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btn_hamburger"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_hamburger"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MIXER"
                android:textColor="#40E0D0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <View
                android:layout_width="32dp"
                android:layout_height="32dp"/>
        </LinearLayout>

        <!-- ✅ VERTICAL SCROLL — WALANG BINAGO -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#081218"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ✅ VOCAL CHANNEL HEADER — WALANG BINAGO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎤 VOCAL CHANNEL"
                    android:textColor="#40E0D0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:background="#12232E"/>

                <!-- ✅ KNOBS CONTAINER — WALANG BINAGO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="12dp">

                    <!-- ✅ GAIN KNOB -->
                    <com.martodosko.studio.KnobView
                        android:id="@+id/knob_gain"
                        android:layout_width="160dp"
                        android:layout_height="180dp"/>

                    <!-- ✅ SENSITIVITY KNOB -->
                    <com.martodosko.studio.KnobView
                        android:id="@+id/knob_sensitivity"
                        android:layout_width="160dp"
                        android:layout_height="180dp"/>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- ✅ SIDE MENU — TINANGGAL ANG BUONG DUPLICATE! <include> NA LANG! TUGMA SA SIDE_MENU.XML! -->
