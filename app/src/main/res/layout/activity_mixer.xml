<!-- FILE: activity_mixer.xml — ✅ MAY SIDE MENU NA! TUGMA SA MixerActivity.kt! -->
<!-- VERSION: 5.0.0 — DrawerLayout + btn_hamburger + btn_close_menu! HANDANG DAGDAGAN! -->
<!-- UPDATED: 2026-09-15 -->
<!-- ================================================== -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- ✅ PANGUNAHING LAMAN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ✅ TOP BAR — MAY HAMBURGER BUTTON! -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E1E2F"
            android:paddingHorizontal="16dp">

            <!-- ✅ HAMBURGER BUTTON — ID = btn_hamburger → TUGMA SA SideMenu.kt! -->
            <ImageView
                android:id="@+id/btn_hamburger"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_hamburger"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MIXER"
                android:textColor="#40E0D0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <View
                android:layout_width="32dp"
                android:layout_height="32dp"/>
        </LinearLayout>

        <!-- ✅ MIXER CONTENT — ORIHINAL NA! WALANG PINAGBAGO! -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#081218"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- CHANNEL HEADER -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="VOCAL CHANNEL"
                    android:textColor="#40E0D0"
                    android:textSize="18sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:background="#12232E"/>

                <!-- ✅ KNOB AREA — HANDANG DAGDAGAN! -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:background="#12232E"
                    android:layout_marginTop="8dp">

                    <!-- ✅ GAIN KNOB — ID = knob_gain → TUGMA SA MixerActivity.kt! -->
                    <com.martodosko.studio.KnobView
                        android:id="@+id/knob_gain"
                        android:layout_width="140dp"
                        android:layout_height="160dp"/>

                    <!-- ✅ DAGDAG MO LANG DITO ANG IBA — HANDANG-HANDA NA!
                    <com.martodosko.studio.KnobView
                        android:id="@+id/knob_bass"
                        android:layout_width="140dp"
                        android:layout_height="160dp"
                        android:layout_marginTop="24dp"/>

                    <com.martodosko.studio.KnobView
                        android:id="@+id/knob_treble"
                        android:layout_width="140dp"
                        android:layout_height="160dp"
                        android:layout_marginTop="24dp"/>
                    -->

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- ✅ SIDE MENU — KOPYAHIN LANG ANG PAREHO SA activity_main.xml! -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1A1A2E"
        android:orientation="vertical"
        android:elevation="16dp">

        <!-- ✅ MENU HEADER + X BUTTON -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#16162A">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MENU"
                android:textColor="#40E0D0"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <!-- ✅ CLOSE BUTTON — ID = btn_close_menu → TUGMA SA SideMenu.kt! -->
            <ImageView
                android:id="@+id/btn_close_menu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333344"/>

        <!-- ✅ MENU OPTIONS — PAREHO SA MAIN! -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/menu_mixer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🎚️  Mixer"
                android:textColor="#40E0D0"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_effects"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🎸  Guitar Effects"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_update"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🔄  Check Update"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_help"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="❓  Help"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_join"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🌐  Join Us"
                android:textColor="#00BFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>

            <TextView
                android:id="@+id/menu_about"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="ℹ️  About"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"/>
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
