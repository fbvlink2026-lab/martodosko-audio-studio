<!-- FILE: activity_main.xml / side_menu.xml — ✅ GUITAR EFFECTS = PANGALAWANG BUTTON! MAY COLLAPSE NA! -->
<!-- VERSION: 2.0.0 — ✅ PAG-AAYOS NG PAGKAKASUNOD + COLLAPSIBLE MENU STRUCTURE! HANDANG-HANDA NA! -->
<!-- UPDATED: 2026-09-19 — ESTILO GANOON PA RIN — PAGKAKASUNOD + COLLAPSE LANG ANG BINAGO! -->
<!-- ================================================== -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- ✅ PANGUNAHING LAMAN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ✅ TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E1E2F"
            android:paddingHorizontal="16dp">

            <!-- ✅ HAMBURGER BUTTON → BUKAS ANG MENU -->
            <ImageView
                android:id="@+id/btn_hamburger"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_hamburger"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MARTODOSKO STUDIO"
                android:textColor="#40E0D0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0.55"
                android:textColor="#666666"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- ✅ MAIN CONTENT AREA -->
        <FrameLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#121212"/>
    </LinearLayout>

    <!-- ✅ SIDE MENU — KALIWA -->
    <LinearLayout
        android:id="@+id/side_menu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1A1A2E"
        android:orientation="vertical"
        android:elevation="16dp">

        <!-- ✅ MENU HEADER + X BUTTON → ISARA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#16162A">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MENU"
                android:textColor="#40E0D0"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <!-- ✅ X BUTTON → ISARA ANG MENU -->
            <ImageView
                android:id="@+id/btn_close_menu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333344"/>

        <!-- ✅ MENU OPTIONS — KOMPLETO NA! MAY COLLAPSE/EXPAND NA! -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <!-- ============================================== -->
            <!-- ✅ 1 — MIXER (PANG-UNA) -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/menu_mixer"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="▼  🎚️  Mixer"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:gravity="center_vertical"
                    android:paddingStart="24dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- ✅ SUB-MENU — NAKATIKLOP NANG UNA -->
                <LinearLayout
                    android:id="@+id/submenu_mixer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="40dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🎤  Vocal Channel"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"
                        android:gravity="center_vertical"
                        android:clickable="true"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🎛️  Mixer Controls"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"
                        android:gravity="center_vertical"
                        android:clickable="true"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ============================================== -->
            <!-- ✅ 2 — GUITAR EFFECTS (PANG-ALAWA — AYON SA UTOS!) -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/menu_guitar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="▶  🎸  Guitar Effects"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:gravity="center_vertical"
                    android:paddingStart="24dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- ✅ SUB-MENU — NAKATIKLOP NANG UNA, HANDANG BUKAS! -->
                <LinearLayout
                    android:id="@+id/submenu_guitar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="40dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🎚️  Effects Channel"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"
                        android:gravity="center_vertical"
                        android:clickable="true"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🎛️  Pedal Controls"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"
                        android:gravity="center_vertical"
                        android:clickable="true"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="📋  Presets"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"
                        android:gravity="center_vertical"
                        android:clickable="true"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ============================================== -->
            <!-- ✅ 3 — PRESETS -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/menu_presets"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="▶  📋  Presets"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:gravity="center_vertical"
                    android:paddingStart="24dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <LinearLayout
                    android:id="@+id/submenu_presets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="40dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🎤  Vocal Presets"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"
                        android:gravity="center_vertical"
                        android:clickable="true"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🎸  Guitar Presets"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"
                        android:gravity="center_vertical"
                        android:clickable="true"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ============================================== -->
            <!-- ✅ 4 — SETTINGS -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/menu_settings"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="▶  ⚙️  Settings"
                    android:textColor="#40E0D0"
                    android:textSize="16sp"
                    android:gravity="center_vertical"
                    android:paddingStart="24dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <LinearLayout
                    android:id="@+id/submenu_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="40dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🔊  Audio Settings"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"
                        android:gravity="center_vertical"
                        android:clickable="true"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🎨  Appearance"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"
                        android:gravity="center_vertical"
                        android:clickable="true"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ============================================== -->
            <!-- ✅ 5 — CHECK UPDATE -->
            <!-- ============================================== -->
            <TextView
                android:id="@+id/menu_update"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🔄  Check Update"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- ============================================== -->
            <!-- ✅ 6 — HELP -->
            <!-- ============================================== -->
            <TextView
                android:id="@+id/menu_help"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="❓  Help"
                android:textColor="#40E0D0"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- ============================================== -->
            <!-- ✅ 7 — JOIN US -->
            <!-- ============================================== -->
            <TextView
                android:id="@+id/menu_join"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🌐  Join Us"
                android:textColor="#00BFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- ============================================== -->
            <!-- ✅ 8 — ABOUT -->
            <!-- ============================================== -->
            <TextView
                android:id="@+id/menu_about"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="ℹ️  About"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- ============================================== -->
            <!-- ✅ 9 — ADMIN PANEL -->
            <!-- ============================================== -->
            <TextView
                android:id="@+id/menu_admin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🔐  Admin Panel"
                android:textColor="#FFD700"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- ============================================== -->
            <!-- ✅ 10 — WHAT'S NEW -->
            <!-- ============================================== -->
            <TextView
                android:id="@+id/menu_whatsnew"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🆕  What's New"
                android:textColor="#00FF88"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- ============================================== -->
            <!-- ✅ 11 — EXIT -->
            <!-- ============================================== -->
            <TextView
                android:id="@+id/menu_exit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="❌  Exit"
                android:textColor="#FF6B6B"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
