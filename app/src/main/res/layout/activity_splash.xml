    android:background="@color/bg_dark" android:padding="32dp">
    <TextView android:text="@string/splash1" android:textSize="42sp"
        android:textStyle="bold" android:textColor="@color/text_white"/>
    <TextView android:text="@string/splash2" android:textSize="18sp"
        android:textColor="@color/text_silver" android:layout_marginTop="8dp"/>
    <View android:layout_width="200dp" android:layout_height="1dp"
        android:background="#444" android:layout_margin="24dp"/>
    <TextView android:text="@string/copyright" android:textSize="14sp"
        android:textColor="@color/text_silver" android:gravity="center"/>
    <TextView android:text="●●● Loading..." android:textSize="16sp"
        android:textColor="@color/green" android:layout_marginTop="40dp"/>
