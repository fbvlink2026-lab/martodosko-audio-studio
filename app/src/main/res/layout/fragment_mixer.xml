<?xml version="1.0" encoding="utf-8"?>
<!-- ================================================== -->
<!-- FILE: activity_mixer.xml -->
<!-- VERSION: 1.0.62 — ISANG CHANNEL LANG + DAGDAG NA PIHITAN! -->
<!-- UPDATED: 2026-09-12 -->
<!-- ================================================== -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080810">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- 📌 PAMAGAT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp"
            android:background="#12121F"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎛️ MARTODOSKO MIXER — CHANNEL 1"
                android:textColor="#40E0D0"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- 📌 PANGUNAHING LAYOUT — KNOBS SA KALIWA | SLIDERS SA KANAN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- ============================================== -->
            <!-- ✅ KALIWA — ISANG CHANNEL LANG + 11 NA PIHITAN! -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.58"
                android:orientation="vertical"
                android:background="#151522"
                android:padding="10dp"
                android:layout_marginEnd="4dp">

                <!-- ============= CHANNEL 1 — 🎤 VOCALS ============= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1A1A2E"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎤 CHANNEL 1 — VOCALS"
                        android:textColor="#FF6B9D"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:paddingBottom="12dp"/>

                    <!-- ⚡ 1. GAIN / INPUT -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="5dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/knob_gain"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="⚡ GAIN" android:textColor="#FF4444" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/val_gain" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 🎚️ 2. LOW / BASS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="5dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/knob_bass"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="🎚️ LOW / BASS" android:textColor="#40E0D0" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/val_bass" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 📊 3. LOW-MID -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="5dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/knob_lowmid"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="📊 LOW-MID" android:textColor="#00BFFF" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/val_lowmid" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 📈 4. MID -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="5dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/knob_mid"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="📈 MID" android:textColor="#FF9500" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/val_mid" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 📊 5. HIGH-MID -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="5dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/knob_highmid"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="📊 HIGH-MID" android:textColor="#FFCC00" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/val_highmid" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 🔆 6. TREBLE / HIGH -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="5dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/knob_treble"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="🔆 TREBLE" android:textColor="#FFD700" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/val_treble" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ✨ 7. PRESENCE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="5dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/knob_presence"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="✨ PRESENCE" android:textColor="#00FF88" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/val_presence" android:text="0 dB" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 🌊 8. REVERB -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="5dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/knob_reverb"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="🌊 REVERB" android:textColor="#BB86FC" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/val_reverb" android:text="0%" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ⏱️ 9. DELAY -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="5dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/knob_delay"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="⏱️ DELAY" android:textColor="#00BFFF" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/val_delay" android:text="0ms" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 🌀 10. COMPRESSOR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="5dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/knob_compressor"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="🌀 COMPRESSOR" android:textColor="#FF6B6B" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/val_compressor" android:text="0%" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 🎯 11. PAN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="5dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/knob_base" android:id="@+id/knob_pan"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp">
                            <TextView android:text="🎯 PAN" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/val_pan" android:text="CENTER" android:textColor="#888" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 🔊 CHANNEL VOLUME — PINAKAIBABA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp"
                        android:layout_marginTop="8dp"
                        android:background="#252540"
                        android:padding="8dp">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/knob_base" android:id="@+id/knob_vol"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp">
                            <TextView android:text="🔊 CHANNEL VOLUME" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/val_vol" android:text="-12 dB" android:textColor="#AAA" android:textSize="11sp"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ============================================== -->
            <!-- ✅ KANAN — SLIDERS: LEFT → RIGHT → MASTER -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.42"
                android:orientation="vertical"
                android:background="#151522"
                android:padding="12dp"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎚️ OUTPUT & MASTER"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:paddingBottom="12dp"/>

                <!-- ◀ LEFT CHANNEL -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◀ LEFT" android:textColor="#40E0D0" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                <SeekBar android:id="@+id/slider_left" android:layout_width="match_parent" android:layout_height="wrap_content" android:progress="50" android:max="100" android:progressTint="#40E0D0" android:thumbTint="#FFFFFF" android:layout_marginBottom="20dp"/>

                <!-- ▶ RIGHT CHANNEL -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶ RIGHT" android:textColor="#FF6B9D" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                <SeekBar android:id="@+id/slider_right" android:layout_width="match_parent" android:layout_height="wrap_content" android:progress="50" android:max="100" android:progressTint="#FF6B9D" android:thumbTint="#FFFFFF" android:layout_marginBottom="20dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A3C" android:layout_marginVertical="6dp"/>

                <!-- ⬡ MONO TOGGLE -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MONO" android:textColor="#AAAAAA" android:textSize="13sp" android:textStyle="bold"/>
                    <ToggleButton android:id="@+id/btn_mono" android:layout_width="56dp" android:layout_height="32dp" android:textOff="OFF" android:textOn="ON" android:backgroundTint="#2A2A3C" android:textColor="#FFFFFF" android:textSize="11sp"/>
                </LinearLayout>

                <!-- 🔊 MASTER VOLUME -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔊 MASTER VOLUME" android:textColor="#FFD700" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/master_vol_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-0 dB" android:textColor="#FFD700" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                <SeekBar android:id="@+id/slider_master" android:layout_width="match_parent" android:layout_height="wrap_content" android:progress="65" android:max="100" android:progressTint="#FFD700" android:thumbTint="#FFFFFF" android:layout_marginBottom="16dp"/>

                <!-- 🔇 MUTE + ⚡ BYPASS -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gap="8dp">
                    <ToggleButton android:id="@+id/btn_mute_all" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textOff="🔇 MUTE" android:textOn="🔇 MUTED" android:backgroundTint="#440000" android:textColor="#FFFFFF" android:paddingVertical="10dp" android:textSize="12sp"/>
                    <ToggleButton android:id="@+id/btn_bypass" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textOff="⚡ BYPASS" android:textOn="⚡ ACTIVE" android:backgroundTint="#003333" android:textColor="#FFFFFF" android:paddingVertical="10dp" android:textSize="12sp"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
