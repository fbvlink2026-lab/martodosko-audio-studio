<?xml version="1.0" encoding="utf-8"?>
<!-- FILE: fragment_mixer.xml — STEP 4: GAIN + BASS ONLY -->
<!-- VERSION: 1.0.76 — DAHAN-DAHAN ✅ 2 KNOBS LANG -->
<!-- UPDATED: 2026-09-13 -->

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080810"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎚️ MIXER — GAIN + BASS LANG"
            android:textColor="#40E0D0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"/>

        <!-- ============================================== -->
        <!-- ✅ GAIN — OKAY NA KANINA -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="#12121F"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="90dp" android:text="GAIN" android:textColor="#AAAAAA" android:textSize="14sp" android:textStyle="bold"/>
            <ImageView android:id="@+id/knob_gain" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_knob"/>
            <TextView android:id="@+id/val_gain" android:layout_width="60dp" android:text="0 dB" android:textColor="#FFFFFF" android:textSize="14sp" android:gravity="end"/>
        </LinearLayout>

        <!-- ============================================== -->
        <!-- ✅ BASS — BAGONG DAGDAG LANG ITO -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="#12121F"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="90dp" android:text="BASS" android:textColor="#AAAAAA" android:textSize="14sp"/>
            <ImageView android:id="@+id/knob_bass" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_knob"/>
            <TextView android:id="@+id/val_bass" android:layout_width="60dp" android:text="0 dB" android:textColor="#FFFFFF" android:textSize="14sp" android:gravity="end"/>
        </LinearLayout>

        <!-- ============================================== -->
        <!-- ⏸️ LAHAT NG IBA — NAKAKOMENTO PA RIN! -->
        <!-- ============================================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iba pa — nakakomento pa rin. Dahan-dahan lang!"
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp"/>

    </LinearLayout>

</ScrollView>
