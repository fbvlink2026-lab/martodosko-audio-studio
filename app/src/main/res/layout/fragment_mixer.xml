<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080810">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- ============================================== -->
        <!-- 🎛️ KALIWA — 1 CHANNEL — MGA PIHITAN -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎤 CHANNEL — VOCALS"
                android:textColor="#40E0D0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333344"/>

            <!-- ✅ HAKBANG 1 — Ilang pihitan lang muna -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="GAIN"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"/>

                <ImageView
                    android:id="@+id/knob_gain"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_knob"
                    android:layout_marginStart="8dp"/>

                <TextView
                    android:id="@+id/val_gain"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="0 dB"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- ✅ Bass -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="BASS"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"/>

                <ImageView
                    android:id="@+id/knob_bass"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_knob"
                    android:layout_marginStart="8dp"/>

                <TextView
                    android:id="@+id/val_bass"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="0 dB"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- ✅ Treble -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="TREBLE"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"/>

                <ImageView
                    android:id="@+id/knob_treble"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_knob"
                    android:layout_marginStart="8dp"/>

                <TextView
                    android:id="@+id/val_treble"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="0 dB"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ============================================== -->
        <!-- 🎚️ KANAN — SLIDERS — HAKBANG 1: ITO LANG MUNA -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OUTPUT"
                android:textColor="#40E0D0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8dp"/>

            <!-- LEFT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L"
                android:textColor="#888888"
                android:textSize="11sp"/>
            <SeekBar
                android:id="@+id/slider_left"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:progress="50"/>

            <!-- RIGHT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R"
                android:textColor="#888888"
                android:textSize="11sp"/>
            <SeekBar
                android:id="@+id/slider_right"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:progress="50"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333344"
                android:layout_marginVertical="8dp"/>

            <!-- MASTER VOLUME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MASTER"
                android:textColor="#FF6B6B"
                android:textSize="11sp"
                android:textStyle="bold"/>
            <SeekBar
                android:id="@+id/slider_master"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:progress="65"/>
            <TextView
                android:id="@+id/master_vol_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 dB"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
