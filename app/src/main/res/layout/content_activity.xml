<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- ✅ PANGUNAHING LAMAN — WALANG BINAGO! -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ✅ TOP BAR — WALANG BINAGO! -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E1E2F"
            android:paddingHorizontal="16dp">

            <!-- ✅ HAMBURGER BUTTON → BUKAS ANG MENU -->
            <ImageView
                android:id="@+id/btn_hamburger"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_hamburger"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MARTODOSKO STUDIO"
                android:textColor="#40E0D0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0.55"
                android:textColor="#666666"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- ✅ MAIN CONTENT AREA — content_container! WALANG BINAGO! -->
        <FrameLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#121212"/>
    </LinearLayout>

    <!-- ✅ SIDE MENU — TINANGGAL ANG BUONG DUPLICATE! <include> NA LANG! TUGMA SA SIDE_MENU.XML! -->
    <include
        layout="@layout/side_menu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"/>

</androidx.drawerlayout.widget.DrawerLayout>
