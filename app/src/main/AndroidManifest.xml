<?xml version="1.0" encoding="utf-8"?>
<!-- ================================================== -->
<!-- FILE: AndroidManifest.xml                          -->
<!-- VERSION: 2.1.0                                     -->
<!-- UPDATED: 2026-10-11                                -->
<!-- PURPOSE: Secure Configuration for Martodosko Studio-->
<!-- AUTHOR: Martodosko Studio                          -->
<!-- NOTE: Removed ghost activities, added audio perms  -->
<!-- ================================================== -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ✅ NETWORK & SECURITY -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- ✅ AUDIO PROCESSING (Critical for <10ms Latency) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    
    <!-- ✅ BACKGROUND EXECUTION (Keep Audio Engine Alive) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" 
        tools:targetApi="34" /> <!-- Required for Android 14+ -->
        
    <!-- ✅ INSTALLATION (For Self-Updates via GitHub/Supabase) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    
    <!-- ✅ STORAGE (Legacy support for Export/Import files) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />

    <!-- Optional: If targeting Android 13+, use granular media permissions instead of READ_EXTERNAL_STORAGE -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <application
        android:name=".MartodoskoApp" <!-- ✅ REGISTERED HILT APP CLASS -->
        android:allowBackup="false"   <!-- ✅ DISABLED BACKUP FOR SECURITY (Prevents data leakage) -->
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Martodosko.Dark" <!-- ✅ CUSTOM THEME -->
        android:networkSecurityConfig="@xml/network_security_config" <!-- ✅ ENFORCE HTTPS -->
        tools:targetApi="34">

        <!-- ========================================== -->
        <!-- ACTIVITIES                                 -->
        <!-- ========================================== -->

        <!-- ✅ SPLASH SCREEN (Launcher) -->
        <activity
            android:name=".ui.screens.SplashActivity" <!-- Updated Package Path -->
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Martodosko.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ✅ MAIN ACTIVITY (Pedal Board / Home Hub) -->
        <activity
            android:name=".ui.screens.MainActivity" <!-- Updated Package Path -->
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- ✅ MIXER ACTIVITY (Detailed Channel View) -->
        <activity
            android:name=".ui.screens.mixer.MixerActivity" <!-- Updated Package Path -->
            android:exported="false"
            android:parentActivityName=".ui.screens.MainActivity" />

        <!-- ✅ CONTENT HOST (Settings, Help, About, Legal, Admin Login) -->
        <activity
            android:name=".ui.screens.ContentActivity" <!-- Consolidated Host -->
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- ✅ ADMIN PANEL DASHBOARD (Role-Gated) -->
        <activity
            android:name=".ui.screens.admin.AdminPanelActivity" <!-- Updated Package Path -->
            android:exported="false"
            android:label="Admin Panel"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" 
            tools:ignore="ProtectedPermissions" /> 
            <!-- Note: Remove permission attr if not using Accessibility services. Just exported=false is enough for internal navigation. -->

        <!-- ========================================== -->
        <!-- SERVICES                                   -->
        <!-- ========================================== -->
        
        <!-- ✅ AUDIO FOREGROUND SERVICE -->
        <service
            android:name=".service.AudioForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- ========================================== -->
        <!-- PROVIDERS                                  -->
        <!-- ========================================== -->

        <!-- ✅ FILE PROVIDER (For Sharing Presets/APK Installs) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
